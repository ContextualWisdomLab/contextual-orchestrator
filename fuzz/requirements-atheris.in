# Atheris coverage-guided job deps. Compile: uv pip compile fuzz/requirements-atheris.in --generate-hashes --python-version 3.12 --universal -o fuzz/requirements-atheris.txt
# Pin atheris==3.1.0 (single version, no interpreter marker). The central
# coverage-evidence image preflights this lock on CPython 3.14 and validates
# every pinned version regardless of environment markers, so a marker-gated
# atheris==3.0.0 line still fails there (3.0.0 has no cp314 wheel). 3.1.0 ships
# cp312/cp313/cp314 wheels, so both the cp312 fuzz job above and the cp314
# preflight resolve it; 3.1.0 dropped the cp311 wheel, which is why the fuzz
# job runs on 3.12 rather than 3.11.
pip
atheris==3.1.0
