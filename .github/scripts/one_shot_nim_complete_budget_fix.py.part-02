    ):
        if type(value) is not int or value < 1:
            raise BenchmarkContractError(f"{label} must be a positive integer")
    evaluation_worker_ceiling = min(model_count, max_eval_models)
    capability_probe_requests = planned_capability_probe_requests(model_count)
    evaluation_requests = planned_evaluation_requests(
        evaluation_worker_ceiling,
        locked_task_count,
    )
    requests_after_catalog = capability_probe_requests + evaluation_requests
    return {
        "catalog_discovery_requests": 1,
        "capability_probe_requests": capability_probe_requests,
        "evaluation_worker_ceiling": evaluation_worker_ceiling,
        "evaluation_requests": evaluation_requests,
        "requests_after_catalog": requests_after_catalog,
        "total_requests": 1 + requests_after_catalog,
    }
