            "requests_spent": request_budget.requests_spent,
            "remaining_requests": request_budget.remaining_requests,
            "planned_request_counts": provenance_inputs["benchmark_parameters"][
                "request_plan"
            ],
        },
'''
    text = replace_once(text, budget_report, budget_report_new, "request plan report evidence")

    markdown_anchor = '''        f"- requests spent: {report['request_budget']['requests_spent']}"
        f" / {report['request_budget']['max_total_requests']}",
        f"- evidence status: `{report['evaluation']['evidence_status']}`",
'''
    markdown_new = '''        f"- requests spent: {report['request_budget']['requests_spent']}"
        f" / {report['request_budget']['max_total_requests']}",
        f"- planned requests: {report['request_budget']['planned_request_counts']['total_requests']} "
        f"(catalog {report['request_budget']['planned_request_counts']['catalog_discovery_requests']}, "
        f"capability {report['request_budget']['planned_request_counts']['capability_probe_requests']}, "
        f"evaluation {report['request_budget']['planned_request_counts']['evaluation_requests']})",
        f"- evidence status: `{report['evaluation']['evidence_status']}`",
'''
    return replace_once(text, markdown_anchor, markdown_new, "markdown request plan evidence")


def update_benchmark_workflow(text: str) -> str:
    """Raise the bounded live ceiling while retaining dynamic preflight failure."""
    text = replace_once(
        text,
        '''      max_total_requests:
        description: "Hard cap on provider requests for this run"
        type: number
        default: 500
''',
        '''      max_total_requests:
        description: "Hard cap on provider requests for this run"
        type: number
        default: 1500
''',
        "manual request ceiling",
    )
    return replace_once(
        text,
        '''          if [ "$EVENT_NAME" = "schedule" ]; then
            echo "max_requests=300" >> "$GITHUB_OUTPUT"
            echo "pricing_scenario=" >> "$GITHUB_OUTPUT"
''',
        '''          if [ "$EVENT_NAME" = "schedule" ]; then
            # The 1,500-call hard ceiling covers the representative 127-model
            # complete-plan preflight regression (1 catalog + 1,143 probes +
            # 140 reserved evaluation calls). A larger dynamic catalog fails
            # before the first capability probe.
            echo "max_requests=1500" >> "$GITHUB_OUTPUT"
            echo "pricing_scenario=" >> "$GITHUB_OUTPUT"
''',
        "scheduled request ceiling",
    )


def update_changelog(text: str) -> str:
    """Record fail-closed complete-run budgeting as a buyer-visible correction."""
    anchor = "## [Unreleased]\n"
    addition = '''## [Unreleased]

### Fixed

- Preflight the complete dynamic NIM request plan immediately after catalog discovery, reserving every model-capability probe and the full equal-budget policy evaluation before any capability egress; insufficient budgets now fail without producing a biased prefix inventory.
- Raise the scheduled NIM benchmark hard ceiling to 1,500 requests, sufficient for the representative 127-model regression plan while retaining fail-closed behavior for larger future catalogs.
'''
    return replace_once(text, anchor, addition, "changelog complete-budget entry")


def update_benchmark_docs(text: str) -> str:
    """Document complete-run preflight and the non-readiness of partial inventories."""
    text = replace_once(
        text,
        "  --max-total-requests 300 \\\n",
        "  --max-total-requests 1500 \\\n",
        "documented live request ceiling",
    )
    old_allocation = '''Before threads start, the harness constructs the full sorted
`(model_id, capability_name)` plan and deterministically allocates the remaining
request budget. Only those fixed cells execute concurrently; the rest receive a
stable `request_budget_exhausted` reason. Thread scheduling cannot decide which
models or modalities receive evidence.
'''
    new_allocation = '''After catalog discovery, the harness computes a conservative complete-run plan
before the first capability probe. The plan reserves all nine capability cells
for every discovered model and the full equal-budget evaluation envelope for up
to `max_eval_models` workers across the locked task split. If the configured cap
is even one request short, the run reports required and configured counts and
stops after catalog discovery without sending a capability request.

A partial capability inventory is not routing-readiness evidence. Every
discovered model receives every capability probe, or the regular benchmark fails
closed. Bounded concurrency can change completion timing only; result ordering
and the set of executed cells remain deterministic.
'''
    return replace_once(
        text,
        old_allocation,
        new_allocation,
        "benchmark complete-run request documentation",
    )


def update_doctoring(text: str) -> str:
    """Record experimental-validity reasoning without inventing catalog prices."""
    anchor = "## Evidence sufficiency and uncertainty\n"
    replacement = '''## Complete-run budget preflight

A dynamic inventory can be scientifically misleading when a hard budget is allocated to a lexicographic prefix of model IDs. The benchmark therefore plans the complete catalog-discovery, capability-inventory, and equal-budget evaluation envelope after discovery and before capability egress. The evaluation reserve uses the conservative assumption that every discovered model could be chat-eligible, capped by the reviewed evaluation-pool size. This makes the preflight independent of thread scheduling and prevents capability sampling from consuming the calls needed for paired policy comparisons.

The permanent regression uses a representative 127-model catalog to prove exact-boundary success, one-request-short failure, zero capability egress on preflight rejection, and preservation of the evaluation reserve. The number is a scale fixture, not a hard-coded provider inventory; production always derives model IDs and the required request count from the live `/v1/models` response.

## Evidence sufficiency and uncertainty
'''
    return replace_once(text, anchor, replacement, "doctoring complete-budget evidence")


def run_command(args: list[str], *, expect_success: bool) -> subprocess.CompletedProcess[str]:
    """Run one verification command and enforce its expected result."""
    completed = subprocess.run(
        args,
        cwd=ROOT,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        check=False,
    )
    print(completed.stdout)
    if expect_success and completed.returncode != 0:
        raise RuntimeError(f"verification failed: {' '.join(args)}")
    if not expect_success and completed.returncode == 0:
        raise RuntimeError(f"red test unexpectedly passed: {' '.join(args)}")
    return completed


def main() -> None:
    """Prove red tests, apply production changes, and run focused verification."""
    rewrite("tests/test_nim_benchmark.py", update_benchmark_tests)
    rewrite(
        "tests/test_nim_benchmark_release_acceptance.py",
        update_release_acceptance_tests,
    )
    rewrite(
        "tests/test_nim_benchmark_workflow_contract.py",
        update_workflow_contract_tests,
    )

    red = run_command(
        [
            "python",
            "-m",
            "pytest",
            "tests/test_nim_benchmark.py",
            "tests/test_nim_benchmark_release_acceptance.py",
            "tests/test_nim_benchmark_workflow_contract.py",
            "-q",
        ],
        expect_success=False,
    )
    if "planned_complete_run_requests" not in red.stdout or "default: 1500" not in red.stdout:
        raise RuntimeError("red evidence did not fail for the planned production gaps")

    rewrite("contextual_orchestrator/nim_benchmark.py", update_benchmark_source)
    rewrite(".github/workflows/nim-benchmark.yml", update_benchmark_workflow)
    rewrite("CHANGELOG.md", update_changelog)
    rewrite("docs/nim_benchmark.md", update_benchmark_docs)
    rewrite(
        "docs/doctoring/nim-benchmark-evidence-grade.md",
        update_doctoring,
    )

    run_command(
        [
            "python",
            "-m",
            "pytest",
            "tests/test_nim_benchmark.py",
            "tests/test_nim_benchmark_release_acceptance.py",
            "tests/test_nim_benchmark_workflow_contract.py",
            "-q",
        ],
        expect_success=True,
    )


if __name__ == "__main__":
    main()
