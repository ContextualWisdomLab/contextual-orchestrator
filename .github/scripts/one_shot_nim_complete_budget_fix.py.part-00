            FAKE_ENDPOINT,
            "key",
            budget,
            2,
            lambda: 1234.0,
            lambda: 0.0,
        )
    assert budget.requests_spent == 0
    assert calls == []


def test_probe_models_exact_budget_covers_every_cell_without_skips() -> None:
    """The exact probe budget executes all model-capability cells under concurrency."""
    models = [
        {"model_id": "b/model-two", "owned_by": ""},
        {"model_id": "a/model-one", "owned_by": ""},
    ]
    calls: list[str] = []

    def transport(method, url, headers, body):
        calls.append(url)
        path = urllib.parse.urlparse(url).path
        return 200, nb._dry_run_success_body(path)

    budget = nb.RequestBudget(18)
    results = nb.probe_discovered_models(
        models,
        transport,
        FAKE_ENDPOINT,
        "key",
        budget,
        2,
        lambda: 1234.0,
        lambda: 0.0,
    )
    all_rows = [row for result in results for row in result["capability_probe_rows"]]
    assert [row["model_id"] for row in results] == ["a/model-one", "b/model-two"]
    assert budget.requests_spent == 18
    assert len(calls) == 18
    assert len(all_rows) == 18
    assert all(row["probe_outcome"] == "supported" for row in all_rows)
'''
    text = replace_once(
        text,
        old_partial_test,
        new_complete_tests,
        "partial probe allocation regression",
    )

    run_test_anchor = '''def test_run_benchmark_rejects_unknown_mode() -> None:
    with pytest.raises(nb.BenchmarkContractError):
        nb.run_benchmark("test", TASK_MANIFEST_PATH, None, "unused")
'''
    run_tests = run_test_anchor + '''\n\ndef _large_catalog_transport(model_count: int):
    """Return a thread-safe-enough in-memory transport and observable call list."""
    calls: list[tuple[str, str]] = []
    catalog_body = json.dumps(
        {
            "data": [
                {"id": f"vendor/model-{index:03d}", "owned_by": "vendor"}
                for index in range(model_count)
            ]
        }
    ).encode("utf-8")

    def transport(method, url, headers, body):
        path = urllib.parse.urlparse(url).path
        calls.append((method, path))
        if method == "GET" and path.endswith("/models"):
            return 200, catalog_body
        return 200, nb._dry_run_success_body(path)

    return transport, calls


