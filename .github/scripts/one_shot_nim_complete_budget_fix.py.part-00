#!/usr/bin/env python3
"""Apply and verify the reviewed complete-run NIM request-budget preflight."""

from __future__ import annotations

import subprocess
from pathlib import Path
from typing import Callable


ROOT = Path(__file__).resolve().parents[2]


def replace_once(text: str, old: str, new: str, label: str) -> str:
    """Replace one exact source fragment or fail closed without partial edits."""
    occurrences = text.count(old)
    if occurrences != 1:
        raise RuntimeError(f"{label}: expected one source fragment, found {occurrences}")
    return text.replace(old, new, 1)


def rewrite(path: str, transform: Callable[[str], str]) -> None:
    """Rewrite one UTF-8 repository file with a deterministic transformation."""
    target = ROOT / path
    original = target.read_text(encoding="utf-8")
    updated = transform(original)
    if updated == original:
        raise RuntimeError(f"{path}: transform produced no change")
    target.write_text(updated, encoding="utf-8")


def update_benchmark_tests(text: str) -> str:
    """Replace partial-prefix expectations with complete-run fail-closed evidence."""
    text = replace_once(
        text,
        "import urllib.error\n",
        "import urllib.error\nimport urllib.parse\n",
        "benchmark test URL parsing import",
    )
    insertion_point = '''def test_budgeted_client_charges_each_chat_call() -> None:
    budget = nb.RequestBudget(1)
    client = nb._BudgetedModelClient(budget)
    agent = _mock_agents("dryrun/chat-basic")[0]
    assert client.chat(agent, [{"role": "user", "content": "hello there"}])
    with pytest.raises(nb.BenchmarkBudgetError):
        client.chat(agent, [{"role": "user", "content": "over budget"}])
'''
    inserted = insertion_point + '''\n\ndef test_capability_probe_request_plan_validates_counts() -> None:
    """Capability planning is exact and rejects booleans, text, and negatives."""
    assert nb.planned_capability_probe_requests(0) == 0
    assert nb.planned_capability_probe_requests(127) == 1143
    for invalid in (True, "127", -1):
        with pytest.raises(nb.BenchmarkContractError):
            nb.planned_capability_probe_requests(invalid)


def test_complete_request_plan_for_127_models_reserves_evaluation() -> None:
    """A representative large catalog reserves every probe and fair evaluation call."""
    plan = nb.planned_complete_run_requests(
        model_count=127,
        locked_task_count=10,
        max_eval_models=7,
    )
    assert plan == {
        "catalog_discovery_requests": 1,
        "capability_probe_requests": 1143,
        "evaluation_worker_ceiling": 7,
        "evaluation_requests": 140,
        "requests_after_catalog": 1283,
        "total_requests": 1284,
    }
    for values in (("127", 10, 7), (127, 0, 7), (127, 10, True)):
        with pytest.raises(nb.BenchmarkContractError):
            nb.planned_complete_run_requests(*values)
'''
    text = replace_once(
        text,
        insertion_point,
        inserted,
        "request-plan tests",
    )

    old_partial_test = '''def test_probe_models_budget_exhaustion_leaves_machine_readable_skips() -> None:
