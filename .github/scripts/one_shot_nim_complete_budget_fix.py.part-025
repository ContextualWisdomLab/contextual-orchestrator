

_original_update_benchmark_source = update_benchmark_source


def update_benchmark_source(text: str) -> str:
    """Apply the complete-plan fix and make its evidence schema mandatory."""
    updated = _original_update_benchmark_source(text)
    anchor = '''    "provenance.benchmark_parameters",
    "catalog_snapshot.endpoint",
'''
    replacement = '''    "provenance.benchmark_parameters",
    "provenance.benchmark_parameters.request_plan",
    "catalog_snapshot.endpoint",
'''
    updated = replace_once(
        updated,
        anchor,
        replacement,
        "request-plan provenance schema",
    )
    budget_anchor = '''    "request_budget.max_total_requests",
    "request_budget.requests_spent",
    "actual_cost_evidence",
'''
    budget_replacement = '''    "request_budget.max_total_requests",
    "request_budget.requests_spent",
    "request_budget.remaining_requests",
    "request_budget.planned_request_counts.catalog_discovery_requests",
    "request_budget.planned_request_counts.capability_probe_requests",
    "request_budget.planned_request_counts.evaluation_worker_ceiling",
    "request_budget.planned_request_counts.evaluation_requests",
    "request_budget.planned_request_counts.requests_after_catalog",
    "request_budget.planned_request_counts.total_requests",
    "actual_cost_evidence",
'''
    return replace_once(
        updated,
        budget_anchor,
        budget_replacement,
        "request-plan budget schema",
    )
