    "script": "import ast\nimport hashlib\nimport json\nimport statistics\nimport subprocess\nimport time\nfrom contextual_orchestrator import orchestrator as routing\nfrom contextual_orchestrator import default_role_effort_catalog\n\nbaseline_head = \"bfeb73a6c58add7a23df052110593cdf43c0b0db\"\nsource = subprocess.check_output([\"git\", \"show\", baseline_head + \":contextual_orchestrator/orchestrator.py\"], text=True)\nparsed = ast.parse(source)\nowner = next(node for node in parsed.body if isinstance(node, ast.ClassDef) and node.name == \"TaskOrchestrator\")\nnames = {\"_psychometric_candidate_id\", \"_selection_design_receipt\"}\nmethods = [node for node in owner.body if isinstance(node, ast.FunctionDef) and node.name in names]\nassert len(methods) == 2\nnamespace = dict(vars(routing))\nexec(compile(ast.Module(body=methods, type_ignores=[]), \"baseline_identity_methods\", \"exec\"), namespace)\nBaseline = type(\"BaselineIdentity\", (routing.TaskOrchestrator,), {name: namespace[name] for name in names})\nagents = [routing.ModelAgent(f\"audit_candidate_{index}\", f\"audit-model-{index}\") for index in range(50)]\nresults = []\nfor condition, catalog in [(\"default_no_catalog\", None), (\"opt_in_catalog\", default_role_effort_catalog())]:\n    variants = {\"baseline\": Baseline(agents, role_effort_catalog=catalog), \"candidate\": routing.TaskOrchestrator(agents, role_effort_catalog=catalog)}\n    samples = {\"baseline\": [], \"candidate\": []}\n    digests = set()\n    try:\n        for iteration in range(63):\n            for variant in ((\"baseline\", \"candidate\") if iteration % 2 == 0 else (\"candidate\", \"baseline\")):\n                start = time.perf_counter_ns()\n                receipt = variants[variant]._selection_design_receipt(agents, [agents[0], agents[1], agents[0]], agents[1])\n                samples[variant].append((time.perf_counter_ns() - start) / 1_000_000)\n                digests.add(hashlib.sha256(json.dumps(receipt, sort_keys=True, separators=(\",\", \":\")).encode()).hexdigest())\n    finally:\n        for orchestrator in variants.values():\n            orchestrator.close()\n    results.append({\"condition\": condition, \"samples_ms\": samples, \"medians_ms\": {key: statistics.median(value) for key, value in samples.items()}, \"receipt_digests\": sorted(digests)})\nprint(json.dumps({\"baseline_head\": baseline_head, \"candidate_head\": subprocess.check_output([\"git\", \"rev-parse\", \"HEAD\"], text=True).strip(), \"results\": results}))\n",
